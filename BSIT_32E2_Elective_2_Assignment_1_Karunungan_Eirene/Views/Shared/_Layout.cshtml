<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BSIT_32E2_Elective_2_Assignment_1_Karunungan_Eirene</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BSIT_32E2_Elective_2_Assignment_1_Karunungan_Eirene.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <header>
        <nav class="navbar navbar-expand-sm quiz-navbar">
            <div class="container quiz-nav-inner">
                <a class="navbar-brand quiz-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="quiz-logo">P1</span>
                    <span class="quiz-brand-text">
                        <span class="quiz-brand-title">Prelim Assignment 1</span>
                        <span class="quiz-brand-sub">BSIT 32E2 &middot; IT Elective 2</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-auto quiz-nav-list">
                        <li class="nav-item">
                            <a class="nav-link quiz-nav-link @(currentAction == "Index" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link quiz-nav-link @(currentAction == "About" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container quiz-footer-inner">
            <span>&copy; 2026 Prelim Assignment 1</span>
            <span>Built with ASP.NET Core MVC</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
