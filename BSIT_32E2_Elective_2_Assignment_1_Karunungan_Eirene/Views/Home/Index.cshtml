@model List<BSIT_32E2_Elective_2_Assignment_1_Karunungan_Eirene.Models.QuizQuestion>
@{
    ViewData["Title"] = "MVC Assignment Answers";
}

<h1>@ViewData["Title"]</h1>


<p class="text-muted">BSIT 32E2 – Elective 2 – Assignment 1</p>

@foreach (var q in Model)
{



    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@q.Number. @q.Question</h5>
            <ul class="list-unstyled">

                @foreach (var opt in q.Options)
                {
                    var isCorrect = opt.Key == q.CorrectAnswer;
                    <li class="@(isCorrect ? "fw-bold text-success" : "")">
                        @opt.Key) @opt.Value @(isCorrect ? "✔" : "")
                    </li>
                }
            </ul>


            <p class="mb-0"><strong>Answer: @q.CorrectAnswer</strong> – @q.Explanation</p>
            @* <p class="mb-0"Answer: @q.CorrectAnswer – @q.Explanation</p> *@
        </div>
    </div>
}